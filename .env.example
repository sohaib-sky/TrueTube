# --- TrueTube server configuration -------------------------------------------
# Copy to `.env` in the project root and adjust. Never commit `.env`.

# Port the API + (in production) the built frontend listen on.
PORT=5000

# Origin allowed by CORS. Use the Vite dev server during development.
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development

# Directory used for temporary download jobs. Created automatically.
# Relative paths are resolved from the project root.
DOWNLOAD_DIR=./server/downloads

# Optional absolute path to the yt-dlp executable. Leave empty to use PATH.
# Windows example: C:\tools\yt-dlp\yt-dlp.exe
# macOS (pipx) example: /opt/homebrew/bin/yt-dlp
YTDLP_PATH=

# Optional absolute path to the ffmpeg binary. Leave empty to use PATH.
FFMPEG_PATH=

# Hard time limits (milliseconds / bytes)
YTDLP_ANALYZE_TIMEOUT_MS=45000
# Downloads are long-running. Raise this for very large files (4K can be GB+).
YTDLP_DOWNLOAD_TIMEOUT_MS=1200000
YTDLP_MAX_BUFFER=52428800
TEMP_FILE_MAX_AGE_MINUTES=30

# Set to `true` only when running behind a reverse proxy you control
# (required for correct client IP detection / rate limiting).
TRUST_PROXY=false
