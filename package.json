{
  "name": "truetube",
  "version": "1.0.0",
  "private": true,
  "description": "TrueTube â€” a modern, real media download utility for supported video URLs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "vite --config client/vite.config.js",
    "client": "npm run dev:client",
    "server": "node server/src/server.js",
    "build": "node scripts/build-sitemap.mjs && node scripts/build-supported-fallback.mjs && vite build --config client/vite.config.js && node scripts/bake-head.mjs",
    "preview": "vite preview --config client/vite.config.js",
    "start": "node server/src/server.js --production"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "three": "^0.169.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "0.25.12",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}

